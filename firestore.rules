rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // حجز اسم المستخدم: مفتاح الوثيقة = الاسم بأحرف صغيرة، لا تعديل ولا حذف
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_]{3,20}$');
      allow update, delete: if false;
    }

    // الملف الشخصي: لا رقم هاتف. الكتابة لصاحبه فقط واسم المستخدم يجب أن يكون محجوزاً له
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.username == resource.data.username;
      allow delete: if false;
    }

    // الصداقات: المعرّف = uidA_uidB مرتّبين، وmembers مرتّبة
    match /friendships/{pid} {
      allow get: if request.auth != null && (resource == null || request.auth.uid in resource.data.members);
      allow list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.requester == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && pid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.members[0])/list/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.members[1])/list/$(request.auth.uid));
      // القبول: من الطرف الآخر فقط، ويغيّر status فقط
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.requester
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
    }

    // الرسائل: بين صديقين مقبولين فقط
    match /chats/{pid}/messages/{mid} {
      function friends() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(pid)).data.members
          && get(/databases/$(database)/documents/friendships/$(pid)).data.status == 'accepted';
      }
      allow read: if friends();
      allow create: if friends() && request.resource.data.from == request.auth.uid;
      allow update, delete: if false;
    }

    // الحظر: يقرؤه ويكتبه صاحبه فقط
    match /blocks/{uid}/list/{target} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // البلاغات: إنشاء فقط
    match /reports/{id} {
      allow create: if request.auth != null && request.resource.data.by == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
